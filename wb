    function wbIcon(name, extraClasses = '', id = '') {
      const path = ICONS_SVG_PATHS[name] || ICONS_SVG_PATHS['cube'];
      const isSpin = extraClasses.includes('fa-spin') || extraClasses.includes('wb-spin') || name === 'spinner';
      const spinCls = isSpin ? ' wb-spin' : '';
      const cleanCls = extraClasses.replace(/fa-spin/g, '').trim();
      const idAttr = id ? ` id="${id}"` : '';
      return `<svg${idAttr} class="wb-svg-icon ${cleanCls}${spinCls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${path}</svg>`;
    }

    // Supabase Endpoints & Credentials
    const SUPABASE_BASE = "https://zjnhdvyuhvegaweyoque.supabase.co/rest/v1";
    const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inpqbmhkdnl1aHZlZ2F3ZXlvcXVlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3Njg4MzgsImV4cCI6MjEwNjM0NDgzOH0.hIN5_wGDJXwcYeYIECZ29MWBdmEjPGlDWuEeJlRWngI";

    // Standard headers for all REST calls
    function getHeaders(extraHeaders = {}) {
      return {
        "apikey": SUPABASE_KEY,
        "Authorization": "Bearer " + SUPABASE_KEY,
        "Content-Type": "application/json",
        "Accept": "application/json",
        ...extraHeaders
      };
    }

    // Direct REST API Helper
    async function apiRequest(endpoint, method = "GET", body = null, extraHeaders = {}) {
      const url = SUPABASE_BASE + endpoint;
      const options = {
        method,
        headers: getHeaders(extraHeaders)
      };
      if (body) {
        options.body = JSON.stringify(body);
      }
      const response = await fetch(url, options);
      if (!response.ok) {
        let errMessage = `HTTP ${response.status}: ${response.statusText}`;
        try {
          const errData = await response.json();
          if (errData && errData.message) errMessage = errData.message;
        } catch (_) {}
        throw new Error(errMessage);
      }
      if (response.status === 204 || method === "DELETE") return null;
      return await response.json();
    }

