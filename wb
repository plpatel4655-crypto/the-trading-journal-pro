    // Toggle Device Pro Status
    async function toggleDevicePro(deviceId, isPro) {
      try {
        const item = purchasesList.find(p => p.device_id === deviceId);
        const patchData = {
          is_pro: isPro,
          updated_at: new Date().toISOString()
        };
        // If enabling Pro and it was expired or had no expiry, give it 1 year from now
        if (isPro && item) {
          const exp = item.expires_at ? new Date(item.expires_at) : null;
          if (!exp || exp < new Date()) {
            const newExp = new Date(Date.now() + (365 * 24 * 60 * 60 * 1000));
            patchData.expires_at = newExp.toISOString();
            item.expires_at = patchData.expires_at;
          }
        }

        await apiRequest(`/user_purchases?device_id=eq.${encodeURIComponent(deviceId)}`, "PATCH", patchData, { "Prefer": "return=minimal" });

        if (item) item.is_pro = isPro;
        showToast(`Device ${deviceId} Pro status set to ${isPro ? 'ACTIVE' : 'REVOKED'}!`, isPro ? "success" : "info");
        renderPurchasesTable(purchasesList);
        updatePurchaseStats();
      } catch (err) {
        showToast("Error updating device: " + err.message, "error");
        fetchPurchases();
      }
    }

    // Extend Device Pro License by +1 Year
    async function extendDevicePro(deviceId) {
      const item = purchasesList.find(p => p.device_id === deviceId);
      if (!item) return;

      const currentExpiry = item.expires_at ? new Date(item.expires_at) : new Date();
      const baseTime = currentExpiry > new Date() ? currentExpiry.getTime() : Date.now();
      const newExpiry = new Date(baseTime + (365 * 24 * 60 * 60 * 1000));

      try {
        await apiRequest(`/user_purchases?device_id=eq.${encodeURIComponent(deviceId)}`, "PATCH", {
          is_pro: true,
          expires_at: newExpiry.toISOString(),
          updated_at: new Date().toISOString()
        }, { "Prefer": "return=minimal" });

        item.is_pro = true;
        item.expires_at = newExpiry.toISOString();
        showToast(`Extended Pro license for device ${deviceId} by +1 Year!`, "success");
        renderPurchasesTable(purchasesList);
        updatePurchaseStats();
      } catch (err) {
        showToast("Error extending license: " + err.message, "error");
      }
    }

