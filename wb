    // Direct REST Login Handler
    async function handleLogin(e) {
      e.preventDefault();
      const usernameInput = document.getElementById("login-username").value.trim();
      const passwordInput = document.getElementById("login-password").value.trim();
      const remember = document.getElementById("remember-me").checked;
      const btn = document.getElementById("login-btn");

      if (!usernameInput || !passwordInput) {
        showToast("Please enter both User ID and Password", "error");
        return;
      }

      btn.disabled = true;
      btn.innerHTML = `${wbIcon("spinner", "wb-spin text-sm")} Authenticating...`;

      try {
        const queryEndpoint = `/admin_users?username=eq.${encodeURIComponent(usernameInput)}&password=eq.${encodeURIComponent(passwordInput)}&select=*`;
        const users = await apiRequest(queryEndpoint, "GET");

        if (!users || users.length === 0) {
          showToast("Invalid User ID or Password. Please try again.", "error");
          btn.disabled = false;
          btn.innerHTML = `<span>Sign In to Dashboard</span>${wbIcon("arrow-right", "text-xs")}`;
          return;
        }

        const admin = users[0];

        // Update last_login in background
        apiRequest(`/admin_users?username=eq.${encodeURIComponent(usernameInput)}`, "PATCH", {
          last_login: new Date().toISOString()
        }).catch(() => {});

        // Store session
        if (remember) {
          localStorage.setItem("wb_admin_session", admin.username);
        } else {
          sessionStorage.setItem("wb_admin_session", admin.username);
        }

        showToast(`Welcome back, ${admin.username}!`, "success");
        showDashboard(admin.username);
      } catch (err) {
        console.error("Login error:", err);
        showToast("Connection Error: " + err.message, "error");
        btn.disabled = false;
        btn.innerHTML = `<span>Sign In to Dashboard</span>${wbIcon("arrow-right", "text-xs")}`;
      }
    }

    function showDashboard(username) {
      const loginSec = document.getElementById("login-section");
      const dashSec = document.getElementById("dashboard-section");

      loginSec.classList.add("hidden");
      loginSec.style.display = "none";
      loginSec.setAttribute("hidden", "true");

      dashSec.classList.remove("hidden");
      dashSec.style.display = "flex";
      dashSec.removeAttribute("hidden");

      document.getElementById("nav-username").innerText = username;
      fetchAllData();

      // Poll periodically every 15 seconds to keep fresh
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(() => {
        fetchAllData(false);
      }, 15000);
    }

    function handleLogout() {
      if (pollInterval) clearInterval(pollInterval);
      localStorage.removeItem("wb_admin_session");
      sessionStorage.removeItem("wb_admin_session");

      const dashSec = document.getElementById("dashboard-section");
      const loginSec = document.getElementById("login-section");

      dashSec.classList.add("hidden");
      dashSec.style.display = "none";
      dashSec.setAttribute("hidden", "true");

      loginSec.classList.remove("hidden");
      loginSec.style.display = "flex";
      loginSec.removeAttribute("hidden");

      document.getElementById("login-username").value = "";
      document.getElementById("login-password").value = "";
      const btn = document.getElementById("login-btn");
      btn.disabled = false;
      btn.innerHTML = `<span>Sign In to Dashboard</span>${wbIcon("arrow-right", "text-xs")}`;
      showToast("Logged out successfully", "info");
    }

