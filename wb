    // Filter Features in Realtime
    function filterFeatures() {
      const search = document.getElementById("feature-search").value.toLowerCase().trim();
      const cat = document.getElementById("category-filter").value;
      const status = document.getElementById("status-filter").value;

      let filtered = featuresList.filter(f => {
        const matchesSearch = f.feature_key.toLowerCase().includes(search) ||
                              f.feature_name.toLowerCase().includes(search) ||
                              (f.description && f.description.toLowerCase().includes(search));

        const matchesCat = (cat === 'ALL') || (f.category === cat);

        let matchesStatus = true;
        if (status === 'ENABLED') matchesStatus = f.is_enabled;
        else if (status === 'DISABLED') matchesStatus = !f.is_enabled;
        else if (status === 'PRO') matchesStatus = f.is_pro;

        return matchesSearch && matchesCat && matchesStatus;
      });

      renderFeaturesTable(filtered);
    }

    // Filter Purchases
    function filterPurchases() {
      const query = (document.getElementById("purchase-search")?.value || "").toLowerCase().trim();
      const statusFilter = document.getElementById("purchase-status-filter")?.value || "all";

      const filtered = purchasesList.filter(p => {
        const matchesQuery = !query ||
          p.device_id.toLowerCase().includes(query) ||
          (p.device_model && p.device_model.toLowerCase().includes(query)) ||
          (p.android_version && p.android_version.toLowerCase().includes(query)) ||
          (p.plan_name && p.plan_name.toLowerCase().includes(query));

        const isExpired = p.expires_at && new Date(p.expires_at) < new Date();
        const effectivePro = p.is_pro && !isExpired;

        if (statusFilter === "pro") return matchesQuery && effectivePro;
        if (statusFilter === "revoked") return matchesQuery && !effectivePro;
        return matchesQuery;
      });

      renderPurchasesTable(filtered);
    }

