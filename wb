    // Save Feature (Add or Update)
    async function handleSaveFeature(e) {
      e.preventDefault();
      const isEdit = document.getElementById("modal-is-edit").value === "true";
      const key = document.getElementById("modal-feature-key").value.trim().toUpperCase();
      const name = document.getElementById("modal-feature-name").value.trim();
      const category = document.getElementById("modal-feature-category").value;
      const isPro = document.getElementById("modal-feature-is-pro").value === "true";
      const desc = document.getElementById("modal-feature-desc").value.trim();
      const isEnabled = document.getElementById("modal-feature-enabled").checked;

      const saveBtn = document.getElementById("modal-save-btn");
      saveBtn.disabled = true;
      saveBtn.innerText = "Saving...";

      try {
        const payload = {
          feature_key: key,
          feature_name: name,
          category: category,
          is_pro: isPro,
          description: desc,
          is_enabled: isEnabled,
          updated_at: new Date().toISOString()
        };

        if (isEdit) {
          await apiRequest(`/app_features?feature_key=eq.${encodeURIComponent(key)}`, "PATCH", payload, {
            "Prefer": "return=minimal"
          });
        } else {
          await apiRequest("/app_features", "POST", payload, {
            "Prefer": "resolution=merge-duplicates"
          });
        }

        closeFeatureModal();
        showToast(`Feature '${name}' saved successfully!`, "success");
        fetchFeatures();
      } catch (err) {
        showToast("Error saving feature: " + err.message, "error");
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerText = "Save Feature";
      }
    }

