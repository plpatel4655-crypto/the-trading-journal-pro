    // Stats updates
    function updateFeatureStats() {
      const toolFeatures = featuresList.filter(f => f.category !== 'SYSTEM');
      const total = toolFeatures.length;
      const enabled = toolFeatures.filter(f => f.is_enabled).length;
      const disabled = total - enabled;
      const percent = total > 0 ? Math.round((enabled / total) * 100) : 0;

      document.getElementById("stat-total-features").innerText = total;
      document.getElementById("stat-enabled-features").innerText = enabled;
      document.getElementById("stat-enabled-percent").innerText = `(${percent}%)`;
      document.getElementById("stat-disabled-features").innerText = disabled;
    }

